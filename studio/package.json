{
  "name": "neetcode-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-monaco.mjs",
    "dev": "next dev --port 3150",
    "prebuild": "node scripts/sync-monaco.mjs",
    "build": "next build",
    "start": "next start --port 3150",
